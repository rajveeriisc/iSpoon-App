<?xml version="1.0" encoding="utf-8"?>
<!--
  flutter_secure_storage's EncryptedSharedPreferences file is backed by a
  hardware-bound Android Keystore key that can never be restored on a new
  install. If this file is restored anyway (Auto Backup / device transfer),
  decryption fails with AEADBadTagException. Exclude it so a reinstall
  always starts with a clean, regeneratable key instead of a corrupt file.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ispoon_secure_prefs.xml" />
        <!-- Holds the plaintext auth-token fallback (background-isolate path). -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="database" path="smartspoon.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ispoon_secure_prefs.xml" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
        <exclude domain="database" path="smartspoon.db" />
    </device-transfer>
</data-extraction-rules>
