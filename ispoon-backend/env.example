# ===========================================
# iSpoon Backend Environment Configuration
# ===========================================
# Copy this file to .env and fill in real values.
# Variables marked REQUIRED must be set or the server will not start.

# Application
NODE_ENV=development            # REQUIRED: development | production
PORT=5000
APP_NAME=SmartSpoon
APP_BASE_URL=http://localhost:5000

# Database (NeonDB PostgreSQL)
DATABASE_URL=postgresql://username:password@host:5432/database  # REQUIRED

# JWT Tokens — use a strong random string (min 32 chars) for both
JWT_SECRET=CHANGE_ME_to_a_random_32plus_char_string              # REQUIRED
JWT_REFRESH_SECRET=CHANGE_ME_to_a_different_random_32plus_string # REQUIRED
JWT_ACCESS_EXPIRY=15m

# Firebase Admin SDK — path to your downloaded service account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccount.json     # REQUIRED

# Email (Resend API — https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx                           # REQUIRED for email features
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# CORS — comma-separated list of allowed frontend origins
# For mobile-only API this can be left as localhost only
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000
TRUST_PROXY=false

# Listen address. Default is loopback so `npm run dev` is not LAN-exposed.
# Phone-on-USB: keep 127.0.0.1 and use `adb reverse tcp:5001 tcp:5001`.
# LAN bind: BIND_HOST=0.0.0.0 and, if DATABASE_URL is Neon, ALLOW_LAN_BIND=1
# only after rotating leaked credentials.
BIND_HOST=127.0.0.1
# ALLOW_LAN_BIND=1

# Required to run migrate/verify scripts against a Neon DATABASE_URL
# ALLOW_LIVE_DB=1

# Protected dependency details for /api/health (send as Authorization: Bearer)
HEALTH_TOKEN=CHANGE_ME_to_a_random_internal_health_token
# Maximum time for each readiness dependency check (milliseconds)
HEALTH_CHECK_TIMEOUT_MS=2000

# Database TLS (production always verifies certificates)
DATABASE_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Rate Limiting
# RATE_LIMIT_WINDOW_MS: window in milliseconds (900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS: max requests per window per IP (general routes)
RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_MAX: max auth attempts per window (stricter)
AUTH_RATE_LIMIT_MAX=5

# File Upload
MAX_FILE_SIZE=5242880    # 5MB in bytes

# ── Firebase Admin (server-side token verification) ───────────────────────────
# These four are REQUIRED and were missing from this file, so a new developer
# could not tell they were needed without reading someone's real .env.
#
# Where they come from: Firebase Console -> Project settings -> Service accounts
# -> "Generate new private key". That JSON contains project_id, client_email and
# private_key. FIREBASE_WEB_API_KEY is on the General tab.
#
# FIREBASE_PRIVATE_KEY keeps its literal \n escapes and MUST be quoted.
# NEVER paste the real values into this file - it is committed.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
FIREBASE_WEB_API_KEY=your-web-api-key
